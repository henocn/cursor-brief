# ── Chatwoot ────────────────────────────────────────────
CHATWOOT_BASE_URL=https://chatwoot.example.com
CHATWOOT_API_TOKEN=votre_token_ici
CHATWOOT_ACCOUNT_ID=1

# ── Conteneurs ─────────────────────────────────────────
# Conteneurs à exclure du monitoring (séparés par des virgules)
IGNORE_CONTAINERS=listmonk_app,listmonk_db

# ── Webhook n8n ────────────────────────────────────────
# Secret partagé entre le cron et le webhook n8n (header X-Brief-Secret)
BRIEF_WEBHOOK_SECRET=changez_moi_avec_un_vrai_secret
# URL du webhook (défaut : http://127.0.0.1:5678/webhook/brief-8h)
# BRIEF_WEBHOOK_URL=http://127.0.0.1:5678/webhook/brief-8h

# ── Sauvegardes (optionnel) ────────────────────────────
# Si Restic est configuré, renseigner le dépôt :
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/mon-bucket/backups
# RESTIC_PASSWORD=motdepasse_restic

# Dossier de backup local (défaut : /opt/backups)
# BACKUP_DIR=/opt/backups

# ── SMTP (utilisé par n8n, pas par le script) ─────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=utilisateur
# SMTP_PASS=motdepasse
