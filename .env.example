# ── Chatwoot ────────────────────────────────────────────
CHATWOOT_BASE_URL=https://chatwoot.example.com
CHATWOOT_API_TOKEN=votre_token_ici
CHATWOOT_ACCOUNT_ID=1

# ── Sauvegardes (optionnel) ────────────────────────────
# Si Restic est configuré, renseigner le dépôt :
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/mon-bucket/backups
# RESTIC_PASSWORD=motdepasse_restic

# Dossier de backup local (défaut : /opt/backups)
# BACKUP_DIR=/opt/backups

# ── Lien « Voir le détail » dans l'e-mail ─────────────
# BRIEF_DETAIL_URL=https://chatwoot.example.com

# ── SMTP (utilisé par n8n, pas par le script) ─────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=utilisateur
# SMTP_PASS=motdepasse
